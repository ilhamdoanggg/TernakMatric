# PostgreSQL (Migration / Owner Role — dipakai hanya saat migrasi DB)
POSTGRES_DB=ternakmatric_staging
POSTGRES_USER=ternakmatric_migrator
POSTGRES_PASSWORD=CHANGE_ME_STAGING_MIGRATOR_PASSWORD
POSTGRES_PORT=5432

# Runtime Application Role (non-superuser, non-owner, NOBYPASSRLS)
APP_DB_USER=ternakmatric_app
APP_DB_PASSWORD=CHANGE_ME_STAGING_APP_PASSWORD

# Backend API Server & Worker
APP_ENV=staging
DATABASE_URL=postgres://ternakmatric_app:CHANGE_ME_STAGING_APP_PASSWORD@db-staging.internal:5432/ternakmatric_staging?sslmode=require
JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES_STAGING_JWT_SECRET
JWT_TTL_MINUTES=720
BIND_ADDR=0.0.0.0:8080
RUST_LOG=api_server=info,worker=info,tower_http=info
