# PostgreSQL (Migration / Owner Role)
POSTGRES_DB=ternakmatric
POSTGRES_USER=ternakmatric_migrator
POSTGRES_PASSWORD=ternakmatric_migrator_dev
POSTGRES_PORT=5432

# Runtime Application Role (non-superuser, non-owner, NOBYPASSRLS)
APP_DB_USER=ternakmatric_app
APP_DB_PASSWORD=ternakmatric_app_dev

# Backend API Server & Worker
# APP_ENV dipakai oleh loader opsional (.env.<APP_ENV> lalu .env); env OS selalu prioritas tertinggi.
APP_ENV=development
DATABASE_URL=postgres://ternakmatric_app:ternakmatric_app_dev@localhost:5432/ternakmatric
JWT_SECRET=ternakmatric-dev-secret-change-in-prod
JWT_TTL_MINUTES=1440
BIND_ADDR=0.0.0.0:8080
RUST_LOG=api_server=info,worker=info,tower_http=info
