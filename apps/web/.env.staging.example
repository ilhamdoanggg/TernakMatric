# Build time (`npm --prefix apps/web run build:staging` atau `vite build --mode staging`):
# Hanya variabel VITE_* yang masuk ke bundle browser; JANGAN taruh secret di VITE_*.
VITE_API_URL=https://api-staging.example.com

# Runtime server SSR (`NODE_ENV=production node apps/web/server.mjs`):
# Variabel non-VITE di bawah disuntikkan ke env proses server/container:
# PORT=3000
# API_INTERNAL_URL=http://api-server:8080
