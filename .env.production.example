# PostgreSQL (Migration / Owner Role — dipakai hanya saat migrasi DB)
POSTGRES_DB=ternakmatric_prod
POSTGRES_USER=ternakmatric_migrator
POSTGRES_PASSWORD=CHANGE_ME_PROD_MIGRATOR_PASSWORD
POSTGRES_PORT=5432

# Runtime Application Role (non-superuser, non-owner, NOBYPASSRLS)
APP_DB_USER=ternakmatric_app
APP_DB_PASSWORD=CHANGE_ME_PROD_APP_PASSWORD

# Backend API Server & Worker (suntikkan via secret manager / container env / systemd)
APP_ENV=production
DATABASE_URL=postgres://ternakmatric_app:CHANGE_ME_PROD_APP_PASSWORD@db-prod.internal:5432/ternakmatric_prod?sslmode=require
JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES_PROD_JWT_SECRET
JWT_TTL_MINUTES=480
BIND_ADDR=0.0.0.0:8080
RUST_LOG=api_server=info,worker=info,tower_http=warn
